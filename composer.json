{
  "name": "johannschopplich/kirbylog",
  "description": "Zero-dependency global `kirbylog()` helper for any content",
  "type": "kirby-plugin",
  "version": "1.4.7",
  "keywords": [
    "kirby",
    "kirby-cms",
    "kirby-plugin",
    "logger"
  ],
  "license": "MIT",
  "homepage": "https://github.com/johannschopplich/kirbylog#readme",
  "authors": [
    {
      "name": "Johann Schopplich",
      "email": "hello@johannschopplich.com",
      "homepage": "https://johannschopplich.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "getkirby/composer-installer": "^1"
  },
  "require-dev": {
    "getkirby/cms": "^5",
    "phpunit/phpunit": "^9"
  },
  "scripts": {
    "csfix": "@php tools/phpcs/vendor/bin/php-cs-fixer fix",
    "test": "phpunit",
    "dist": "composer install --no-dev --optimize-autoloader"
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "extra": {
    "kirby-cms-path": "tests/fixtures/kirby",
    "kirby": {
      "compatible": "^5.0"
    }
  }
}
